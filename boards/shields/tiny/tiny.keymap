#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&caps_word {
  continue-list = <UNDERSCORE MINUS SPACE BACKSPACE DELETE>;
};

/ {

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <200>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            /* hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 54 55 56 57 58 59>; */
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <200>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            /* hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 53>; */
            hold-trigger-on-release;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHIFT>, <&caps_word>, <&kp N3>;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ` 1 2 3 4 5 6 7 8 9 0 DEL
            // TAB Q W E R T Y U I O P '
            // ESC A S(alt) D(ctrl) F(shift) G H J(shift) K(ctrl) L(alt) ; BSPC
            // SHIFT Z X C V B N M , . / SHIFT
            // GUI _ ALT CTRL SYMB ENT NUM/SPC NAV/ESC RCTRL RALT _ RGUI
            bindings = <
                &kp GRAVE  &kp N1        &kp N2      &kp N3       &kp N4       &kp N5   &kp N6        &kp N7       &kp N8       &kp N9      &kp N0         &kp DEL
                &kp TAB    &kp Q         &kp W       &kp E        &kp R        &kp T    &kp Y         &kp U        &kp I        &kp O       &kp P          &kp SQT
                &kp ESC    &hml LGUI A   &hml LALT S &hml LCTRL D &hml LSHFT F &kp G    &kp H         &hmr RSHFT J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI &kp BSPC
                &td0       &kp Z         &kp X       &kp C        &kp V        &kp B    &kp N         &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp RSHFT
                &kp LGUI   &none   &kp LALT    &kp LCTRL    &mo 1        &kp RET  &lt 3 SPACE   &lt 2 ESC    &kp RCTRL    &kp RALT    &kp RGUI       &none
            >;
        };

        symb_layer {
            // F1-F12 on top row, symbols on rows 2-4
            bindings = <
                &kp F1    &kp F2    &kp F3    &kp F4     &kp F5    &kp F6   &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
                &kp GRAVE &kp N1    &kp N2    &kp LT     &kp GT    &kp LBKT &kp RBKT  &kp AMPS  &kp PIPE  &kp GRAVE &trans    &trans
                &trans    &kp EXCL  &kp EQUAL &kp MINUS  &kp LPAR  &kp LBRC &kp RBRC  &kp RPAR  &kp DOT   &kp HASH  &kp AT    &trans
                &trans    &kp PRCNT &kp DLLR  &kp PLUS   &kp UNDER &none    &kp ASTRK &kp CARET &kp SEMI  &kp COLON &kp BSLH  &trans
                &trans    &trans    &trans    &trans     &none     &trans   &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        nav_layer {
            // Navigation: arrows, word jump, page up/down
            bindings = <
                &trans    &trans    &trans      &trans       &trans       &trans   &trans        &trans       &trans     &trans        &trans       &trans
                &kp ESC   &kp Q     &kp W       &kp E        &kp R        &kp T    &kp LC(DEL)   &kp LC(LEFT) &none      &kp LC(RIGHT) &kp LC(BSPC) &none
                &kp TAB   &kp A     &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G    &kp LEFT      &kp DOWN     &kp UP     &kp RIGHT     &kp HOME     &trans
                &trans    &kp Z     &kp X       &kp C        &kp V        &kp CAPS &none         &kp PG_DN    &kp PG_UP  &none         &kp END      &trans
                &none     &kp LCTRL &mo 1       &kp RET      &kp LGUI     &none    &kp SPACE     &trans       &kp RCTRL  &kp RALT      &none        &none
            >;
        };

        num_layer {
            // Numpad right half; BT left half: ` = clear, 1/2/3/5 = profiles 0-3, A = next, D = prev
            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3  &bt BT_SEL 4 &trans        &trans    &trans    &trans    &trans           &kp KP_NUM
                &trans     &trans        &trans        &trans        &trans     &trans        &kp KP_MINUS  &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_SLASH    &kp DEL
                &trans     &bt BT_NXT    &trans        &bt BT_PRV    &trans     &trans        &kp KP_PLUS   &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_MULTIPLY &kp BSPC
                &trans     &trans        &trans        &trans        &trans     &trans        &kp KP_N0     &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_DOT      &kp KP_ENTER
                &trans     &trans        &trans        &trans        &trans     &trans        &trans        &trans    &trans    &trans    &trans          &trans
            >;
        };

        game_layer {
            // Gaming: no home row mods and change around the layout to work for lefthandend freaks sucha as myself
            bindings = <
                &trans    &trans    &trans      &trans       &trans       &trans  &trans        &trans       &trans     &trans        &trans       &trans
                &kp ESC   &kp Q     &kp W       &kp E        &kp R        &kp T   &kp LC(DEL)   &kp LC(LEFT) &none      &kp LC(RIGHT) &kp LC(BSPC) &none
                &kp TAB   &kp A     &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G   &kp LEFT      &kp DOWN     &kp UP     &kp RIGHT     &kp HOME     &trans
                &kp LSHFT &kp Z     &kp X       &kp C        &kp V        &kp B   &none         &kp PG_DN    &kp PG_UP  &none         &kp END      &trans
                &kp LALT  &kp LCTRL &mo 1       &kp RET      &kp LGUI     &none   &kp SPACE     &trans       &kp RCTRL  &kp RALT      &none        &none
            >;
        };
    };
};
